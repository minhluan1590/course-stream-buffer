{
  "manifest_version": 3,
  "name": "Course Stream Buffer",
  "version": "1.2.3",
  "description": "Safely monitor Udemy lecture buffering with optional live diagnostics.",
  "permissions": [
    "storage"
  ],
  "host_permissions": ["https://www.udemy.com/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
  
