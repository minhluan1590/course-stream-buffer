{
  "manifest_version": 3,
  "name": "Course Stream Buffer",
  "version": "1.3.0",
  "description": "Request a bounded 60-second Udemy player buffer with optional diagnostics.",
  "permissions": [
    "storage"
  ],
  "host_permissions": ["https://www.udemy.com/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.udemy.com/*"],
      "js": ["player_bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
  
